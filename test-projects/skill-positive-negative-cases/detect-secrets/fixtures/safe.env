# SAFE FIXTURE — detect-secrets test
# No credential values, no AWS key patterns, no token-shaped strings.
# All runtime values are injected via CI/CD secrets manager.

APP_ENV=production
LOG_LEVEL=info
PORT=8080
DB_HOST=db.internal
DB_NAME=myapp
DB_USER=appuser

# Runtime secrets are injected at deploy time from HashiCorp Vault.
# See docs/secrets-management.md for the vault path convention.
# These variables are empty here; the deployment system populates them.
DB_PASS=
JWT_SIGNING_KEY=
THIRD_PARTY_WEBHOOK_URL=
