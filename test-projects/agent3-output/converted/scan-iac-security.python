ory': 'Logging', 'name': 'Azure SQL Server threat detection alerts are enabled for all threat types', 'description': 'Azure SQL Server threat detection alerts are enabled for all threat types', 'match_strategy': 'checkov_graph_check', 'remediation': 'Update the IaC resource so it satisfies the policy requirement.'}, {'id': 'CHECKOV-CKV2-AWS-71', 'severity': 'Medium', 'category': 'Network Security', 'name': 'Ensure AWS ACM Certificate domain name does not include wildcards', 'description': 'Ensure AWS ACM Certificate domain name does not include wildcards', 'match_strategy': 'checkov_graph_check', 'remediation': 'Update the IaC resource so it satisfies the policy requirement.'}, {'id': 'CHECKOV-CKV2-AWS-33', 'severity': 'Medium', 'category': 'Application Security', 'name': 'Ensure AppSync is protected by WAF', 'description': 'Ensure AppSync is protected by WAF', 'match_strategy': 'checkov_graph_check', 'remediation': 'Update the IaC resource so it satisfies the policy requirement.'}, {'id': 'CHECKOV-CKV2-AWS-72', 'severity': 'Medium', 'category': 'Network Security', 'name': 'Ensure AWS CloudFront origin protocol policy enforces HTTPS-only', 'description': 'Ensure AWS CloudFront origin protocol policy enforces HTTPS-only', 'match_strategy': 'checkov_graph_check', 'remediation': 'Update the IaC resource so it satisfies the policy requirement.'}, {'id': 'CHECKOV-CKV2-AWS-75', 'severity': 'Medium', 'category': 'Network Security', 'name': 'Ensure no open CORS policy', 'description': 'Ensure no open CORS policy', 'match_strategy': 'checkov_graph_check', 'remediation': 'Update the IaC resource so it satisfies the policy requirement.'}, {'id': 'CHECKOV-CKV2-AWS-69', 'severity': 'Medium', 'category': 'Network Security', 'name': 'Ensure AWS RDS database instance configured with encryption in transit', 'description': 'Ensure AWS RDS database instance configured with encryption in transit', 'match_strategy': 'checkov_graph_check', 'remediation': 'Update the IaC resource so it sa