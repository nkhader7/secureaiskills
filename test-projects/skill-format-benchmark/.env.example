# ─── Local / Hosted LLM Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real credentials.

# Base URL of your LLM API server
# Examples:
#   http://localhost:8080          (LM Studio, Ollama)
#   https://llm.internal.company  (enterprise gateway)
#   http://192.168.1.50:11434      (Ollama on another host)
LLM_BASE_URL=http://localhost:8080

# OAuth2 client credentials (grant_type=client_credentials)
# Leave blank if your server uses a plain bearer token instead.
LLM_CLIENT_ID=your-client-id
LLM_CLIENT_SECRET=your-client-secret

# OAuth2 token endpoint (relative to LLM_BASE_URL if it starts with /)
# Common paths: /oauth/token  /auth/token  /v1/auth/token
LLM_TOKEN_URL=/oauth/token

# Models list endpoint (relative to LLM_BASE_URL)
# Common paths: /v1/models  /models  /api/tags (Ollama)
LLM_MODELS_URL=/v1/models

# Chat completions endpoint
LLM_CHAT_URL=/v1/chat/completions

# Maximum tokens for LLM response
LLM_MAX_TOKENS=4096
